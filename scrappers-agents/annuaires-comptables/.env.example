# SMTP (Mailjet) — pour l'email récap envoyé après chaque vague
EMAIL__SMTP_HOST=in-v3.mailjet.com
EMAIL__SMTP_PORT=587
EMAIL__SMTP_USERNAME=
EMAIL__SMTP_PASSWORD=
EMAIL__USE_TLS=true
EMAIL__FROM_ADDRESS=notification@business-tracker.fr

# Nombre de cabinets contactés par vague journalière
CABINETS_PER_DAY=100

# Fuseau horaire (la fenêtre 09:30–12:30 est en heure locale)
TZ=Europe/Paris
